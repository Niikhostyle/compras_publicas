# Opcional: también puedes guardar la clave desde Administración.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# Para sustituir la contraseña inicial, genera un hash con:
# node scripts/password-hash.mjs
ADMIN_PASSWORD_HASH=
# Activa SOLO detrás de un proxy que sobrescriba X-Forwarded-For.
TRUST_PROXY=false

# En produccion: ruta privada absoluta, fuera de public_html.
# Si se omite, se usa ~/.local/share/norma-compras.
NORMA_DATA_DIR=

# Vacío para https://compras.chanco.cl. Solo cambiar si se instala en subcarpeta.
# Debe tener el mismo valor al compilar y al ejecutar.
NEXT_PUBLIC_BASE_PATH=
