# Opcional: también puedes guardar la clave desde Administración.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# Para sustituir la contraseña inicial, genera un hash con:
# node scripts/password-hash.mjs
ADMIN_PASSWORD_HASH=
# Activa SOLO detrás de un proxy que sobrescriba X-Forwarded-For.
TRUST_PROXY=false
